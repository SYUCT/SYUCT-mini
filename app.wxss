/* app.wxss — 全局样式（蓝白主色，与网页版一致） */
page {
  --primary: #075ca8;
  --primary-light: #1f6feb;
  --bg: #f4f6f9;
  --card: #ffffff;
  --border: #e3e8ef;
  --text: #1f2328;
  --text-secondary: #6e7781;
  --accent: #d2991d;

  background: var(--bg);
  color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

/* 通用卡片 */
.card {
  background: var(--card);
  border-radius: 20rpx;
  padding: 28rpx;
  margin: 20rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(7, 92, 168, 0.06);
}

.card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 12rpx;
}

.card-subtitle {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.section-gap {
  height: 20rpx;
}

/* 标签 */
.badge {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  background: rgba(7, 92, 168, 0.1);
  color: var(--primary);
  margin-right: 12rpx;
}

/* 列表行 */
.list-row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.list-row:last-child {
  border-bottom: none;
}

.list-row .list-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.list-row .list-main {
  flex: 1;
  min-width: 0;
}

.list-row .list-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
}

.list-row .list-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
}

.list-row .list-arrow {
  color: var(--text-secondary);
  font-size: 28rpx;
  margin-left: 12rpx;
}

/* 主按钮 */
.btn-primary {
  background: var(--primary);
  color: #fff;
  border-radius: 16rpx;
  padding: 20rpx 40rpx;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
}

.btn-secondary {
  background: rgba(7, 92, 168, 0.08);
  color: var(--primary);
  border-radius: 16rpx;
  padding: 20rpx 40rpx;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
}

/* 空态 */
.empty {
  text-align: center;
  color: var(--text-secondary);
  padding: 60rpx 0;
  font-size: 26rpx;
}

/* 网页版同步内容通用样式 */
.page-head {
  padding: 40rpx 32rpx 12rpx;
}

.page-title {
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.3;
}

.page-sub {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-top: 10rpx;
  line-height: 1.7;
}

.sync-badge {
  display: inline-flex;
  margin-top: 16rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(7, 92, 168, 0.08);
  color: var(--primary);
  font-size: 22rpx;
  font-weight: 600;
}

.callout {
  margin: 20rpx 24rpx;
  padding: 22rpx 24rpx;
  border-radius: 16rpx;
  background: rgba(7, 92, 168, 0.07);
  border: 1rpx solid rgba(7, 92, 168, 0.18);
  color: #285475;
  font-size: 25rpx;
  line-height: 1.75;
}

.callout.warning {
  background: #fff8e6;
  border-color: #f0d48a;
  color: #7a5c12;
}

.section-block {
  margin: 34rpx 24rpx 0;
  scroll-margin-top: 24rpx;
}

.section-block-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.35;
  margin-bottom: 10rpx;
}

.section-block-icon {
  flex-shrink: 0;
}

.section-block-lead {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.75;
  margin-bottom: 16rpx;
}

.section-card {
  background: var(--card);
  border: 1rpx solid var(--border);
  border-radius: 20rpx;
  padding: 8rpx 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(7, 92, 168, 0.05);
}

.doc-description {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 6rpx;
  line-height: 1.6;
}

.doc-meta {
  font-size: 22rpx;
  color: var(--primary);
  margin-top: 8rpx;
}

.check-list {
  background: var(--card);
  border: 1rpx solid var(--border);
  border-radius: 20rpx;
  padding: 10rpx 28rpx;
}

.check-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.check-item:last-child {
  border-bottom: none;
}

.check-mark {
  width: 38rpx;
  height: 38rpx;
  border-radius: 50%;
  background: rgba(7, 92, 168, 0.1);
  color: var(--primary);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 800;
  margin-top: 3rpx;
}

.check-copy {
  flex: 1;
}

.check-title {
  font-size: 27rpx;
  font-weight: 700;
}

.check-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
  line-height: 1.65;
}

.action-row {
  display: flex;
  gap: 16rpx;
  margin: 18rpx 0 4rpx;
}

.action-row .btn-primary,
.action-row .btn-secondary {
  flex: 1;
  padding-left: 16rpx;
  padding-right: 16rpx;
}

.page-footer {
  text-align: center;
  font-size: 24rpx;
  color: var(--text-secondary);
  padding: 40rpx 24rpx 60rpx;
}

.step-list {
  margin-top: 8rpx;
}

.step-item {
  display: flex;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.step-item:last-child {
  border-bottom: none;
}

.step-num {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: var(--primary);
  color: #fff;
  font-size: 25rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.step-body {
  flex: 1;
}

.step-title {
  font-size: 29rpx;
  font-weight: 700;
}

.step-desc {
  font-size: 25rpx;
  color: var(--text-secondary);
  margin-top: 5rpx;
  line-height: 1.65;
}

.section-block .callout.compact {
  margin: 12rpx 0 16rpx;
}

.section-post-note {
  margin-top: 16rpx;
  margin-bottom: 0;
}
