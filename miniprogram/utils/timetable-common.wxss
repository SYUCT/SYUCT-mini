.calendar-mask { position: fixed; inset: 0; z-index: 120; display: flex; align-items: flex-end; background: rgba(12, 28, 48, .48); }
.calendar-modal { width: 100%; max-height: 88vh; padding: 30rpx 28rpx calc(28rpx + env(safe-area-inset-bottom)); box-sizing: border-box; border-radius: 32rpx 32rpx 0 0; background: #f6f9ff; box-shadow: 0 -10rpx 48rpx rgba(14, 47, 77, .12); }
.calendar-heading { display: flex; align-items: center; justify-content: space-between; margin-bottom: 22rpx; gap: 18rpx; }
.calendar-title { font-size: 34rpx; font-weight: 800; color: #173c59; }
.calendar-close { min-width: 90rpx; padding: 15rpx; text-align: center; border-radius: 16rpx; background: #e8effa; color: #075ca8; font-size: 25rpx; }
.calendar-scroll { max-height: 68vh; }
.calendar-label { margin: 20rpx 0 12rpx; color: #244760; font-weight: 700; font-size: 26rpx; }
.calendar-picker { padding: 22rpx; border: 1rpx solid #d9e4f2; border-radius: 18rpx; background: #fff; font-size: 28rpx; color: #173c59; }
.calendar-switch-row { display: flex; align-items: center; justify-content: space-between; margin: 18rpx 0; gap: 18rpx; }
.calendar-help { color: #728599; font-size: 23rpx; line-height: 1.65; }
.calendar-notice { margin: 22rpx 0; padding: 22rpx; border-radius: 18rpx; color: #315775; background: #e8f1fd; line-height: 1.7; font-size: 25rpx; }
.calendar-primary, .calendar-danger { padding: 23rpx 18rpx; margin-top: 22rpx; border-radius: 18rpx; font-size: 28rpx; text-align: center; font-weight: 700; }
.calendar-primary { color: #fff; background: linear-gradient(115deg, #075ca8, #377ae1); }
.calendar-danger { color: #ba3646; background: #fff0f2; }
.calendar-record { padding: 22rpx 10rpx; border-bottom: 1rpx solid #dfe7f1; font-size: 26rpx; color: #204864; line-height: 1.5; }
.calendar-detail { margin-bottom: 24rpx; padding: 26rpx; border: 1rpx solid #dce7f2; border-radius: 24rpx; background: #fff; }
.calendar-course-name { font-size: 34rpx; font-weight: 800; line-height: 1.5; color: #173c59; overflow-wrap: break-word; }
.calendar-tags { display: flex; flex-wrap: wrap; gap: 12rpx; margin: 12rpx 0; font-size: 22rpx; color: #075ca8; }
.calendar-meta { display: flex; align-items: flex-start; gap: 20rpx; margin: 16rpx 0; font-size: 27rpx; color: #244760; line-height: 1.65; }
.calendar-meta-label { flex-shrink: 0; color: #728599; }
.day-status { font-size: 18rpx; line-height: 1.5; color: #94712a; white-space: nowrap; }
.day-status.is-adjusted { color: #096a98; }
