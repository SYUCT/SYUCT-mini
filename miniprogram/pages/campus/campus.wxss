/* pages/campus/campus.wxss */
.page-head {
  padding: 40rpx 32rpx 8rpx;
}

.page-title {
  font-size: 40rpx;
  font-weight: 800;
}

.page-sub {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-top: 8rpx;
}

.section-head {
  margin: 40rpx 32rpx 20rpx;
}

.eyebrow {
  font-size: 24rpx;
  color: var(--primary);
  font-weight: 600;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  margin-top: 6rpx;
}

/* 栏目空态：兼作投稿征集入口，收到文档后自动被列表替换 */
.section-empty {
  background: var(--card);
  border: 1rpx dashed #c9d8e8;
  border-radius: 20rpx;
  padding: 44rpx 32rpx 36rpx;
  text-align: center;
}

.section-empty-icon {
  font-size: 56rpx;
  line-height: 1;
}

.section-empty-title {
  font-size: 29rpx;
  font-weight: 700;
  color: var(--primary);
  margin-top: 16rpx;
}

.section-empty-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.75;
  margin-top: 12rpx;
  text-align: left;
}

.section-empty-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}

.section-empty-btn {
  flex: 1;
  padding: 18rpx 12rpx;
  font-size: 26rpx;
}

/* 相册 */
.gallery-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin: 0 24rpx;
}

.gallery-item {
  position: relative;
  border-radius: 16rpx;
  overflow: hidden;
  height: 220rpx;
  background: #e8ecf1;
}

.gallery-item:first-child {
  grid-column: span 2;
  height: 320rpx;
}

.gallery-img {
  width: 100%;
  height: 100%;
  display: block;
}

.gallery-label {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 40rpx 16rpx 12rpx;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.6));
  color: #fff;
  font-size: 24rpx;
}

/* 校园跑规则说明 */
.sports-note {
  margin-top: 0;
}

.sports-note-text {
  font-size: 26rpx;
  color: var(--text);
  line-height: 1.7;
}

.section-block + .section-block {
  margin-top: 40rpx;
}
