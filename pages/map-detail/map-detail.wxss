/* pages/map/map.wxss */
.page-head {
  padding: 40rpx 32rpx 8rpx;
}

.page-title {
  font-size: 40rpx;
  font-weight: 800;
}

.page-sub {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-top: 8rpx;
}

/* 地图卡片 */
.map-card {
  margin: 24rpx;
  border-radius: 24rpx;
  overflow: hidden;
  position: relative;
  background: #ffffff;
  box-shadow: 0 4rpx 20rpx rgba(7, 92, 168, 0.15);
}

.map-image {
  width: 100%;
  height: 860rpx;
  display: block;
  background: #f7f8fa;
}

.map-overlay {
  padding: 24rpx 28rpx 28rpx;
  background: #ffffff;
  color: var(--text);
}

.map-name {
  font-size: 32rpx;
  font-weight: 700;
}

.map-desc {
  font-size: 24rpx;
  opacity: 0.85;
  margin-top: 4rpx;
}

.map-meta {
  font-size: 22rpx;
  opacity: 0.82;
  margin-top: 8rpx;
}

.map-tap {
  font-size: 24rpx;
  color: var(--primary);
  margin-top: 8rpx;
  font-weight: 600;
}

/* 地点 */
.place-list {
  margin-top: 8rpx;
}

.list-num {
  font-size: 24rpx;
  color: var(--primary);
  background: rgba(7, 92, 168, 0.08);
  border-radius: 999rpx;
  padding: 6rpx 18rpx;
  flex-shrink: 0;
  font-weight: 600;
}

.card-hint {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 20rpx;
  line-height: 1.6;
}

.page-footer {
  text-align: center;
  font-size: 24rpx;
  color: var(--text-secondary);
  padding: 20rpx 0 60rpx;
}

.section-block .map-card {
  margin: 16rpx 0 0;
}

.sports-check {
  margin-top: 24rpx;
}

/* 体育课成绩构成小字说明 */
.score-note {
  margin-top: 20rpx;
  padding: 20rpx 24rpx;
  background: #f6f8fb;
  border-radius: 16rpx;
  border: 1rpx solid rgba(7, 92, 168, 0.08);
}

.score-note-title {
  font-size: 23rpx;
  font-weight: 700;
  color: var(--text-secondary);
  margin-bottom: 8rpx;
}

.score-note-text {
  font-size: 22rpx;
  color: var(--text-secondary);
  line-height: 1.7;
}

.panorama-card {
  background: linear-gradient(155deg, #ffffff 0%, #eef6ff 100%);
  border: 1rpx solid rgba(7, 92, 168, 0.18);
  border-radius: 22rpx;
  padding: 0;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(7, 92, 168, 0.08);
}

.panorama-cover {
  width: 100%;
  height: 320rpx;
  display: block;
  background: #06284b;
}

.panorama-body {
  padding: 30rpx;
}

.panorama-type {
  display: inline-block;
  padding: 5rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(7, 92, 168, 0.1);
  color: var(--primary);
  font-size: 22rpx;
  font-weight: 700;
}

.panorama-title {
  font-size: 31rpx;
  font-weight: 800;
  margin-top: 14rpx;
}

.panorama-desc,
.panorama-note {
  font-size: 25rpx;
  color: var(--text-secondary);
  line-height: 1.75;
  margin-top: 10rpx;
}

.panorama-btn {
  margin-top: 22rpx;
}

.panorama-note {
  font-size: 22rpx;
  margin-top: 16rpx;
}

/* 快递取件导航 */
.delivery-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin: 20rpx 0;
}

.delivery-item {
  flex: 1 1 45%;
  background: #f6f8fb;
  border: 1rpx solid rgba(7, 92, 168, 0.08);
  border-radius: 16rpx;
  padding: 18rpx 22rpx;
}

.delivery-name {
  font-size: 27rpx;
  font-weight: 700;
  color: var(--text);
}

.delivery-desc {
  font-size: 23rpx;
  color: var(--text-secondary);
  margin-top: 6rpx;
  line-height: 1.55;
}

.delivery-note {
  margin: 16rpx 0 0;
  font-size: 23rpx;
  color: var(--text-secondary);
  line-height: 1.65;
}

.section-block .map-card {
  margin: 16rpx 0 0;
}
