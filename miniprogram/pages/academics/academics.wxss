/* pages/academics/academics.wxss */
.page-head {
  padding: 40rpx 32rpx 8rpx;
}

.page-title {
  font-size: 40rpx;
  font-weight: 800;
}

.page-sub {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-top: 8rpx;
}

.cat-card {
  background: #fff;
  border-radius: 20rpx;
  margin: 24rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(7, 92, 168, 0.06);
  border: 1rpx solid var(--border);
}

.cat-head {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.cat-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.cat-name {
  font-size: 30rpx;
  font-weight: 700;
  flex: 1;
}

.cat-count {
  font-size: 22rpx;
  color: var(--text-secondary);
  background: var(--bg);
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
}

.section-block:last-of-type {
  margin-bottom: 20rpx;
}
