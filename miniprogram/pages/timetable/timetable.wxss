.timetable-page {
  padding-bottom: 40rpx;
}

.timetable-hero {
  margin: 24rpx;
  padding: 32rpx;
  border-radius: 28rpx;
  color: #fff;
  background: linear-gradient(145deg, #063f72, #075ca8 62%, #1f6feb);
  box-shadow: 0 8rpx 30rpx rgba(7, 92, 168, 0.2);
}

.hero-topline {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 20rpx;
}

.hero-kicker {
  font-size: 23rpx;
  opacity: 0.78;
  letter-spacing: 1rpx;
}

.hero-title {
  font-size: 46rpx;
  line-height: 1.25;
  font-weight: 800;
  margin-top: 4rpx;
}

.settings-button {
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
  font-size: 24rpx;
  font-weight: 600;
}

.hero-summary {
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.2);
}

.summary-main {
  font-size: 27rpx;
  font-weight: 600;
}

.summary-week {
  font-size: 36rpx;
  font-weight: 800;
}

.summary-sub {
  margin-top: 6rpx;
  font-size: 23rpx;
  line-height: 1.6;
  opacity: 0.82;
}

/* 缺开学日期时这行是个待办入口，比普通说明文字更醒目 */
.summary-sub-link {
  display: inline-block;
  margin-top: 12rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
  font-weight: 600;
  opacity: 1;
}

.week-controls {
  display: flex;
  gap: 12rpx;
  margin-top: 24rpx;
}

.week-button,
.week-current {
  flex: 1;
  text-align: center;
  padding: 14rpx 8rpx;
  border-radius: 14rpx;
  font-size: 24rpx;
  font-weight: 600;
  background: rgba(255, 255, 255, 0.13);
}

.week-current {
  background: #fff;
  color: var(--primary);
}

.week-button.is-disabled {
  opacity: 0.42;
}

.action-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin: 0 24rpx 18rpx;
}

.action-card {
  min-width: 0;
  background: #fff;
  border: 1rpx solid var(--border);
  border-radius: 18rpx;
  padding: 16rpx 12rpx;
  text-align: center;
  box-shadow: 0 2rpx 12rpx rgba(7, 92, 168, 0.05);
}

.action-card:active {
  transform: scale(0.98);
  background: #f7faff;
}

.action-icon {
  width: 46rpx;
  height: 46rpx;
  border-radius: 14rpx;
  margin: 0 auto 8rpx;
  background: rgba(7, 92, 168, 0.09);
  color: var(--primary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 800;
}

.action-title {
  font-size: 24rpx;
  line-height: 1.3;
  font-weight: 700;
}

.action-desc {
  font-size: 18rpx;
  line-height: 1.3;
  color: var(--text-secondary);
  margin-top: 4rpx;
  white-space: nowrap;
}

.week-panel {
  margin: 0 24rpx;
  background: #fff;
  border: 1rpx solid var(--border);
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 14rpx rgba(7, 92, 168, 0.05);
}

.week-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 22rpx 12rpx;
}

.week-head-main {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  min-width: 0;
}

.week-head-title {
  font-size: 28rpx;
  line-height: 1.3;
  font-weight: 750;
}

.week-head-sub {
  font-size: 20rpx;
  line-height: 1.3;
  color: var(--text-secondary);
  white-space: nowrap;
}

.week-head-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

/* 跳周视图的入口：视图切换，与添加/导入/分享那三个动作卡片区分开 */
.grid-entry {
  padding: 5rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(7, 92, 168, 0.08);
  color: var(--primary);
  font-size: 20rpx;
  font-weight: 600;
}

.local-badge {
  padding: 5rpx 12rpx;
  border-radius: 999rpx;
  background: #edf7ef;
  color: #1a7f37;
  font-size: 19rpx;
  font-weight: 600;
}

.weekday-scroll {
  width: 100%;
  white-space: nowrap;
  border-top: 1rpx solid var(--border);
  border-bottom: 1rpx solid var(--border);
  background: #fafbfc;
}

.weekday-row {
  display: inline-flex;
  padding: 12rpx 18rpx;
  gap: 8rpx;
}

.weekday-item {
  position: relative;
  width: 84rpx;
  box-sizing: border-box;
  text-align: center;
  padding: 12rpx 6rpx;
  border-radius: 16rpx;
  color: var(--text-secondary);
}

.weekday-item.is-selected {
  background: var(--primary);
  color: #fff;
}

.weekday-item.is-today:not(.is-selected) {
  background: rgba(7, 92, 168, 0.08);
  color: var(--primary);
}

.weekday-name {
  font-size: 25rpx;
  font-weight: 700;
}

.weekday-date {
  height: 30rpx;
  font-size: 19rpx;
  opacity: 0.78;
  margin-top: 2rpx;
}

.weekday-count {
  position: absolute;
  top: 5rpx;
  right: 5rpx;
  min-width: 24rpx;
  height: 24rpx;
  line-height: 24rpx;
  border-radius: 12rpx;
  padding: 0 4rpx;
  background: #d2991d;
  color: #fff;
  font-size: 16rpx;
}

.course-list {
  padding: 18rpx 20rpx 24rpx;
}

.course-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 22rpx;
  border-radius: 18rpx;
  margin-top: 14rpx;
  border-left: 8rpx solid #075ca8;
  background: #f7faff;
}

.course-card:first-child {
  margin-top: 0;
}

.course-card:active {
  opacity: 0.84;
}

.course-time {
  width: 230rpx;
  flex-shrink: 0;
}

.course-section-row {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  flex-wrap: wrap;
}

.course-section {
  font-size: 25rpx;
  font-weight: 750;
  color: var(--primary);
}

.course-weeks {
  font-size: 19rpx;
  color: var(--text-secondary);
  line-height: 1.4;
}

.course-clock {
  font-size: 20rpx;
  color: #52606d;
  margin-top: 7rpx;
  line-height: 1.4;
}

.course-main {
  flex: 1;
  min-width: 0;
}

.course-name {
  font-size: 30rpx;
  line-height: 1.4;
  font-weight: 750;
}

.course-meta {
  font-size: 23rpx;
  color: var(--text-secondary);
  margin-top: 5rpx;
  word-break: break-all;
}

.course-edit {
  font-size: 19rpx;
  color: var(--primary);
  margin-top: 8rpx;
}

.course-current {
  flex-shrink: 0;
  min-width: 64rpx;
  box-sizing: border-box;
  padding: 7rpx 12rpx;
  border-radius: 999rpx;
  text-align: center;
  font-size: 19rpx;
  line-height: 1.2;
  font-weight: 700;
  color: #075ca8;
  background: rgba(7, 92, 168, 0.09);
}

.course-card.tone-1 .course-current { color: #8250df; background: rgba(130, 80, 223, 0.10); }
.course-card.tone-2 .course-current { color: #1a7f37; background: rgba(26, 127, 55, 0.10); }
.course-card.tone-3 .course-current { color: #9a6700; background: rgba(191, 135, 0, 0.11); }
.course-card.tone-4 .course-current { color: #cf222e; background: rgba(207, 34, 46, 0.09); }
.course-card.tone-5 .course-current { color: #0969da; background: rgba(9, 105, 218, 0.09); }

.course-card.tone-1 { border-left-color: #8250df; background: #faf8ff; }
.course-card.tone-2 { border-left-color: #1a7f37; background: #f4fbf6; }
.course-card.tone-3 { border-left-color: #bf8700; background: #fffaf0; }
.course-card.tone-4 { border-left-color: #cf222e; background: #fff7f7; }
.course-card.tone-5 { border-left-color: #0969da; background: #f5f9ff; }

.empty-state {
  padding: 56rpx 36rpx 46rpx;
  text-align: center;
}

.empty-icon {
  font-size: 54rpx;
}

.empty-title {
  font-size: 29rpx;
  font-weight: 750;
  margin-top: 12rpx;
}

.empty-desc {
  font-size: 23rpx;
  color: var(--text-secondary);
  margin-top: 8rpx;
  line-height: 1.65;
}

.empty-actions {
  display: flex;
  justify-content: center;
  gap: 14rpx;
  margin-top: 24rpx;
}

.empty-button {
  padding: 14rpx 24rpx;
  border-radius: 14rpx;
  background: #f0f3f6;
  color: var(--text);
  font-size: 24rpx;
  font-weight: 600;
}

.empty-button.primary {
  background: var(--primary);
  color: #fff;
}

.data-note {
  margin: 24rpx;
  padding: 24rpx 26rpx;
  border-radius: 20rpx;
  border: 1rpx solid #d9e8f5;
  background: #f7fbff;
}

.data-note-title {
  font-size: 27rpx;
  font-weight: 700;
  color: #075ca8;
}

.data-note-text {
  font-size: 22rpx;
  line-height: 1.75;
  color: #52606d;
  margin-top: 7rpx;
}

/* 这行是跳网页版社区的入口，用主色区分于周围的说明文字 */
.data-note-link {
  color: var(--primary);
  font-weight: 600;
}

.modal-mask {
  position: fixed;
  inset: 0;
  z-index: 120;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  background: rgba(0, 0, 0, 0.48);
}

.form-modal {
  width: 100%;
  max-height: 88vh;
  box-sizing: border-box;
  background: #fff;
  border-radius: 30rpx 30rpx 0 0;
  padding: 30rpx 28rpx calc(30rpx + env(safe-area-inset-bottom));
}

.modal-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 800;
}

.modal-sub {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
}

.modal-close-text {
  color: var(--primary);
  font-size: 25rpx;
  padding: 8rpx 0 8rpx 18rpx;
}

.form-scroll {
  max-height: 70vh;
}

.field-label {
  font-size: 23rpx;
  font-weight: 650;
  color: #4b5563;
  margin: 18rpx 0 8rpx;
}

.field-label-note {
  color: var(--text-secondary);
  font-size: 20rpx;
  font-weight: 500;
}

.field-input,
.field-picker {
  box-sizing: border-box;
  width: 100%;
  min-height: 82rpx;
  border: 1rpx solid #d8dee4;
  border-radius: 14rpx;
  background: #f9fafb;
  padding: 18rpx 20rpx;
  font-size: 27rpx;
}

.field-picker {
  display: flex;
  align-items: center;
}

.field-picker.placeholder {
  color: #9aa4af;
}

.course-name-input-wrap {
  width: 100%;
}

.course-name-suggestions {
  margin-top: 8rpx;
  border: 1rpx solid #d8dee4;
  border-radius: 14rpx;
  background: #fff;
  overflow: hidden;
  box-shadow: 0 6rpx 20rpx rgba(7, 92, 168, 0.08);
}

.course-name-suggestion {
  padding: 15rpx 20rpx;
  border-top: 1rpx solid #edf0f2;
  font-size: 25rpx;
  line-height: 1.35;
  color: var(--text);
}

.course-name-suggestion:first-child {
  border-top: none;
}

.course-name-suggestion:active {
  background: #f2f7fc;
  color: var(--primary);
}

.field-help {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.55;
  color: var(--text-secondary);
}

.field-grid {
  display: flex;
  gap: 16rpx;
}

.field-half {
  flex: 1;
  min-width: 0;
}

.form-actions {
  margin-top: 28rpx;
  padding-bottom: 16rpx;
}

.save-button {
  text-align: center;
  background: var(--primary);
  color: #fff;
  border-radius: 16rpx;
  padding: 19rpx 20rpx;
  font-size: 27rpx;
  font-weight: 700;
}

.delete-button {
  text-align: center;
  color: #cf222e;
  background: #fff2f2;
  border-radius: 16rpx;
  padding: 18rpx 20rpx;
  font-size: 26rpx;
  font-weight: 650;
  margin-top: 14rpx;
}

.settings-modal {
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.settings-scroll {
  max-height: 70vh;
}

.settings-save {
  margin-top: 28rpx;
}

.settings-divider {
  height: 1rpx;
  background: var(--border);
  margin: 30rpx 0 8rpx;
}

.settings-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 20rpx 4rpx;
  border-bottom: 1rpx solid var(--border);
}

.settings-row:last-child {
  border-bottom: none;
}

.settings-row-title {
  font-size: 27rpx;
  font-weight: 650;
}

.settings-row-desc {
  font-size: 21rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
}

.settings-row-action {
  color: var(--primary);
  font-size: 24rpx;
  font-weight: 650;
  flex-shrink: 0;
}

.data-note-text-gap {
  margin-top: 12rpx;
}
