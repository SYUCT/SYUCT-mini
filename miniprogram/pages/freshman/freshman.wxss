/* pages/freshman/freshman.wxss */
.page-head {
  padding: 40rpx 32rpx 8rpx;
}

.page-title {
  font-size: 40rpx;
  font-weight: 800;
}

.page-sub {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-top: 8rpx;
}

/* 适用范围提示 */
.scope-tip {
  margin: 20rpx 24rpx 0;
  padding: 20rpx 24rpx;
  background: #fff8e6;
  border: 1rpx solid #f0d48a;
  border-radius: 16rpx;
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.scope-icon {
  font-size: 30rpx;
  flex-shrink: 0;
}

.scope-text {
  font-size: 24rpx;
  color: #8a6d1a;
  line-height: 1.7;
}

/* 时间线 */
.timeline {
  margin-top: 12rpx;
}

.timeline-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
}

.timeline-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--primary);
  margin-right: 20rpx;
  flex-shrink: 0;
}

.timeline-date {
  font-weight: 700;
  color: var(--primary);
  width: 220rpx;
  flex-shrink: 0;
  white-space: nowrap;
}

.timeline-event {
  color: var(--text);
}

/* 步骤 */
.step-list {
  margin-top: 12rpx;
}

.step-item {
  display: flex;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.step-item:last-child {
  border-bottom: none;
}

.step-num {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: var(--primary);
  color: #fff;
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.step-body {
  flex: 1;
}

.step-title {
  font-size: 30rpx;
  font-weight: 600;
}

.step-desc {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-top: 6rpx;
}

/* 群 */
.group-actions {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  flex-shrink: 0;
  margin-left: 12rpx;
}

.group-btn {
  font-size: 22rpx;
  font-weight: 600;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  text-align: center;
  line-height: 1.4;
}

.group-btn-copy {
  background: rgba(7, 92, 168, 0.08);
  color: var(--primary);
}

.page-footer {
  text-align: center;
  font-size: 24rpx;
  color: var(--text-secondary);
  padding: 40rpx 0 60rpx;
}

.timeline-highlight {
  background: rgba(7, 92, 168, 0.06);
  border-radius: 12rpx;
  padding-left: 12rpx;
  padding-right: 12rpx;
}

.timeline-highlight .timeline-date,
.timeline-highlight .timeline-event {
  font-weight: 700;
}

.check-item-link {
  position: relative;
  cursor: pointer;
}

.check-item-link:active {
  background: rgba(7, 92, 168, 0.05);
}

.check-item-link .check-title {
  white-space: nowrap;
}

.check-item-link .check-title::after {
  content: ' · 查看';
  color: var(--primary);
  font-weight: 500;
  font-size: 20rpx;
  vertical-align: middle;
}

.payment-warning {
  margin-left: 0;
  margin-right: 0;
}

.loan-doc-card {
  margin-top: 18rpx;
}

.loan-doc-title {
  white-space: nowrap;
}
