<import src="../../utils/timetable-templates.wxml" />
<view class="page grid-page">
  <view class="grid-hero">
    <view class="compact-weekbar">
      <view class="compact-arrow {{selectedWeek <= 1 ? 'is-disabled' : ''}}" bindtap="previousWeek">‹</view>
      <picker class="compact-week-picker" mode="selector" range="{{weekOptions}}" value="{{selectedWeek - 1}}" bindchange="onWeekChange"><view>第 {{selectedWeek}} 周 <text>⌄</text></view></picker>
      <view class="compact-arrow {{selectedWeek >= state.settings.totalWeeks ? 'is-disabled' : ''}}" bindtap="nextWeek">›</view>
      <view class="compact-today" bindtap="goCurrentWeek">本周</view>
      <view class="compact-toggle" bindtap="toggleOtherWeeks">切换</view>
    </view>
    <view class="compact-caption">{{showOtherWeeks ? '全部课程 · 含非本周' : '本周课程'}} · {{weekCourseCount}} 个安排 · 点星期可调课</view>
  </view>
  <view class="grid-wrap">
    <view class="grid-head">
      <view class="grid-corner">节次</view>
      <view class="grid-day {{item.isToday ? 'is-today' : ''}}" wx:for="{{weekdays}}" wx:key="weekday" bindtap="openAdjustment" data-weekday="{{item.weekday}}">
        <view class="grid-day-name">{{item.label}}</view>
        <view class="grid-day-date">{{item.dateLabel || ' '}}</view>
        <view class="day-status {{item.status == 'adjusted' ? 'is-adjusted' : ''}}" wx:if="{{item.statusLabel}}">{{item.statusLabel}}</view>
      </view>
    </view>
    <view class="grid-body" style="height: {{gridHeight}}rpx;">
      <view class="grid-sections">
        <view class="grid-section" wx:for="{{rows}}" wx:key="section" style="height: {{rowHeight}}rpx;">
          <view class="grid-section-num">{{item.section}}</view>
          <view class="grid-section-time">{{item.startLabel}}</view>
          <view class="grid-section-time">{{item.endLabel}}</view>
        </view>
      </view>
      <view class="grid-canvas">
        <view class="grid-line" wx:for="{{rows}}" wx:key="section" style="top: {{index * rowHeight}}rpx; height: {{rowHeight}}rpx;"></view>
        <view class="grid-col {{item.isToday ? 'is-today' : ''}}" wx:for="{{weekdays}}" wx:key="weekday" style="left: {{index * 14.285714}}%;"></view>
        <view class="grid-block tone-{{item.colorIndex}} {{item.span == 1 ? 'is-single' : ''}} {{item.inWeek ? '' : 'is-outside'}} {{item.isCurrent ? 'is-current' : ''}}"
          wx:for="{{blocks}}" wx:key="key" style="top: {{item.top}}rpx; height: {{item.height}}rpx; left: {{(item.weekday - 1) * 14.285714}}%;" bindtap="openDetail" bindlongpress="deleteBlock" hover-class="is-pressed" data-key="{{item.key}}">
          <view class="block-inner {{item.overflow ? 'has-badge' : ''}}">
            <view class="block-badge" wx:if="{{item.overflow}}">{{item.overflow}}</view>
            <view class="block-state" wx:if="{{item.isCurrent}}">上课中</view>
            <view class="block-tag" wx:elif="{{!item.inWeek}}">非本周</view>
            <view class="block-tag adjusted-tag" wx:elif="{{item.adjusted}}">调课</view>
            <view class="block-name">{{item.name}}</view>
            <view class="block-room" wx:if="{{item.room}}"><text wx:if="{{item.roomBuilding}}">{{item.roomBuilding}}</text><text wx:if="{{item.roomNumber}}">{{item.roomNumber}}</text><text wx:if="{{!item.roomBuilding && !item.roomNumber}}">{{item.room}}</text></view>
          </view>
        </view>
        <view class="grid-no-courses" wx:if="{{!blocks.length}}">本周没有课程<view>可返回课表页导入，或切换查看全部</view></view>
      </view>
    </view>
  </view>
  <view class="page-footer"><text>点击课程查看详情与修改 · 长按课程可删除</text></view>
  <template is="course-detail" data="{{detail:detail}}" />
  <template is="adjustment-editor" data="{{showAdjustmentModal, adjustmentForm, adjustmentRecords, adjustmentMinDate, adjustmentMaxDate, adjustmentPreview}}" />
</view>
