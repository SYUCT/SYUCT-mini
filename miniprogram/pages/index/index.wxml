<view class="page">
  <view class="hero">
    <image class="hero-bg" src="/assets/hero-campus.jpg" mode="aspectFill" />
    <view class="hero-overlay"></view>
    <view class="hero-content">
      <view class="hero-kicker">{{home.heroKicker}}</view>
      <view class="hero-title">沈阳化工大学<text class="hero-title-accent">校园指南</text></view>
      <view class="hero-desc">{{home.heroDescription}}<text class="hero-desc-sub">{{home.heroSub}}</text></view>
      <view class="hero-actions">
        <view class="btn-primary hero-btn" bindtap="onPortalTap" data-page="/pages/freshman/freshman">从新生指南开始</view>
        <view class="btn-secondary hero-btn" bindtap="openGroupModal">加入交流群</view>
      </view>
      <view class="hero-meta">
        <text class="badge">非官方学生共建站</text>
        <text class="badge">资料整理至 {{site.updatedMonth}}</text>
      </view>
    </view>
  </view>

  <view class="stats-grid">
    <view class="stat-item" wx:for="{{stats}}" wx:key="label">
      <view class="stat-value">{{item.value}}</view>
      <view class="stat-label">{{item.label}}</view>
    </view>
  </view>

  <view class="section">
    <view class="section-head">
      <view class="eyebrow">{{home.portalEyebrow}}</view>
      <view class="section-title">{{home.portalTitle}}</view>
      <view class="section-lead">{{home.portalLead}}</view>
    </view>
    <view class="portal-grid">
      <view class="portal-card" wx:for="{{portals}}" wx:key="title" bindtap="onPortalTap" data-page="{{item.page}}">
        <view class="portal-icon">{{item.icon}}</view>
        <view class="portal-body">
          <view class="portal-title">{{item.title}}</view>
          <view class="portal-desc">{{item.desc}}</view>
          <view class="portal-link">{{item.action}}</view>
        </view>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-head">
      <view class="eyebrow">{{home.quickEyebrow}}</view>
      <view class="section-title">{{home.quickTitle}}</view>
    </view>
    <view class="quick-list">
      <view class="quick-item" wx:for="{{quickQuestions}}" wx:key="num" bindtap="onQuickTap" data-page="{{item.page}}">
        <view class="quick-num">{{item.num}}</view>
        <view class="quick-body">
          <view class="quick-title">{{item.title}}</view>
          <view class="quick-desc">{{item.desc}}</view>
        </view>
        <view class="quick-arrow">›</view>
      </view>
    </view>
  </view>

  <view class="section home-gallery-section">
    <view class="section-head gallery-section-head">
      <view>
        <view class="eyebrow">{{home.galleryEyebrow}}</view>
        <view class="section-title">{{home.galleryTitle}}</view>
      </view>
      <view class="gallery-more" bindtap="openCampusGallery">查看完整相册 →</view>
    </view>
    <view class="home-gallery-grid">
      <view class="home-gallery-item {{index == 0 ? 'home-gallery-feature' : ''}}" wx:for="{{home.featuredGallery}}" wx:key="file" bindtap="previewHomeImage" data-index="{{item.viewerIndex}}">
        <image src="{{item.file}}" mode="aspectFill" lazy-load="{{true}}" />
        <view class="home-gallery-label">{{item.label}}</view>
      </view>
    </view>
  </view>

  <view class="community-strip">
    <view class="community-text">
      <view class="eyebrow">交流与共建</view>
      <view class="community-title">资料有遗漏，欢迎一起补全</view>
      <view class="community-desc">QQ群 {{site.qqGroup}}。入群可获取更新，也可以提交经验、表格和纠错。</view>
    </view>
    <view class="btn-secondary community-btn" bindtap="openGroupModal">查看交流群</view>
  </view>

  <view class="site-footer">
    <view>非官方学生共建站，请以学校当年正式通知为准。</view>
    <view class="footer-links" bindtap="openSite">沈阳化工大学官网 ↗</view>
    <view class="footer-update">内容基线：网页版 {{site.sourceVersion}} · {{site.updatedAt}}</view>
  </view>

  <view class="modal-mask" wx:if="{{showGroupModal}}" bindtap="closeGroupModal">
    <view class="modal-body" catchtap="preventBubble">
      <view class="modal-title">加入校园交流群</view>
      <view class="group-option {{index == 0 ? 'group-option-first' : ''}}" wx:for="{{communityGroups}}" wx:key="id">
        <view class="group-option-head">
          <view class="group-option-icon">{{item.icon}}</view>
          <view class="group-option-main">
            <view class="group-option-title">{{item.title}}</view>
            <view class="group-option-desc">{{item.desc}}</view>
          </view>
        </view>
        <view class="group-number">QQ群 {{item.number}}</view>
        <view class="group-modal-actions">
          <view class="modal-qq group-modal-btn" bindtap="copyCommunityGroup" data-number="{{item.number}}" data-label="{{item.copyLabel}}">复制群号</view>
        </view>
      </view>
      <view class="btn-primary modal-close" bindtap="closeGroupModal">关闭</view>
    </view>
  </view>
</view>
