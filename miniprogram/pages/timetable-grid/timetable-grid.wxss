@import "../../utils/timetable-common.wxss";

/* 七天保持竖屏同宽；主要空间留给课表，跨节课程按行高连续定位。 */
.grid-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 16rpx 0 calc(28rpx + env(safe-area-inset-bottom));
  background: linear-gradient(160deg, #edf5ff, #f4f6fb 60%, #eff2ff);
}
.grid-hero { margin: 0 16rpx 18rpx; }
.compact-weekbar { display: flex; align-items: center; gap: 12rpx; }
.compact-arrow, .compact-today, .compact-toggle, .compact-week-picker {
  min-height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: 1rpx solid #dce6f3;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, .94);
  color: #285674;
  font-size: 26rpx;
  font-weight: 700;
  white-space: nowrap;
  box-shadow: 0 4rpx 12rpx rgba(44, 81, 122, .04);
}
.compact-arrow { width: 72rpx; flex-shrink: 0; font-size: 36rpx; }
.compact-arrow.is-disabled { opacity: .4; }
.compact-week-picker { flex: 1; min-width: 150rpx; text-align: center; }
.compact-week-picker > view { padding: 18rpx 6rpx; }
.compact-week-picker text { color: #8da3b8; margin-left: 6rpx; }
.compact-today { width: 100rpx; flex-shrink: 0; }
.compact-toggle { width: 122rpx; flex-shrink: 0; color: #fff; background: linear-gradient(120deg, #075ca8, #377ae1); border-color: transparent; }
.compact-caption { margin: 12rpx 4rpx 0; color: #7b8c9f; font-size: 22rpx; line-height: 1.5; }
.grid-wrap { margin: 0 12rpx; overflow: hidden; border: 1rpx solid #dfe7f0; border-radius: 24rpx; background: #fff; box-shadow: 0 8rpx 30rpx rgba(31, 61, 90, .06); }
.grid-head { display: flex; align-items: stretch; border-bottom: 1rpx solid #dfe6ee; background: linear-gradient(180deg, #fff, #f3f7fd); }
.grid-corner { width: 64rpx; flex-shrink: 0; display: flex; align-items: center; justify-content: center; color: #71869b; font-size: 19rpx; }
.grid-day { flex: 1; min-width: 0; padding: 14rpx 0 12rpx; text-align: center; }
.grid-day-name { font-size: 23rpx; font-weight: 700; color: #355570; line-height: 1.5; }
.grid-day-date { min-height: 24rpx; color: #8c9bad; font-size: 18rpx; line-height: 1.5; }
.grid-day.is-today { background: #e7f0ff; box-shadow: inset 0 -4rpx 0 #4f7abc; }
.grid-day.is-today .grid-day-name { color: #075ca8; }
.grid-body { position: relative; display: flex; background: #fff; }
.grid-sections { width: 64rpx; flex-shrink: 0; border-right: 1rpx solid #e3eaf3; background: #f5f8fd; }
.grid-section { display: flex; flex-direction: column; align-items: center; justify-content: center; box-sizing: border-box; border-bottom: 1rpx solid #e7edf3; }
.grid-section-num { color: #426b8a; font-size: 25rpx; font-weight: 700; line-height: 1.5; }
.grid-section-time { color: #8b9bad; font-size: 17rpx; line-height: 1.45; }
.grid-canvas { position: relative; flex: 1; min-width: 0; }
.grid-line { position: absolute; left: 0; right: 0; box-sizing: border-box; border-bottom: 1rpx solid #e7edf3; }
.grid-col { position: absolute; top: 0; bottom: 0; width: 14.285714%; box-sizing: border-box; border-right: 1rpx solid #edf1f5; }
.grid-col.is-today { background: rgba(7, 92, 168, .018); }
.grid-block { position: absolute; z-index: 2; width: 14.285714%; box-sizing: border-box; padding: 5rpx 3rpx; }
.block-inner { height: 100%; box-sizing: border-box; overflow: hidden; position: relative; padding: 12rpx 7rpx; border: 1rpx solid rgba(75, 120, 190, .1); border-radius: 18rpx; background: linear-gradient(150deg, #eaf2ff, #e3edfc); }
.block-name { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 5; overflow: hidden; word-break: break-all; color: #2c4c68; font-size: 23rpx; font-weight: 700; line-height: 1.45; }
.block-room { display: flex; flex-direction: column; margin-top: 10rpx; color: #658099; font-size: 21rpx; line-height: 1.5; overflow-wrap: break-word; }
.block-badge { position: absolute; top: 3rpx; right: 3rpx; padding: 0 6rpx; min-width: 20rpx; border-radius: 10rpx; background: #d2991d; color: #fff; font-size: 16rpx; text-align: center; line-height: 26rpx; }
.has-badge .block-name { padding-top: 14rpx; }
.block-tag, .block-state { display: inline-flex; border-radius: 8rpx; padding: 1rpx 3rpx; margin-bottom: 4rpx; font-size: 17rpx; line-height: 1.5; background: #e8ebef; color: #7b8793; }
.block-state { color: #fff; background: #075ca8; }
.adjusted-tag { color: #076b8d; background: #dbf2fa; }
.grid-block.is-single .block-name { font-size: 20rpx; -webkit-line-clamp: 2; }
.grid-block.is-single .block-room { margin-top: 4rpx; font-size: 17rpx; }
.tone-1 .block-inner { background: linear-gradient(150deg, #f1eafa, #eae3f7); }
.tone-2 .block-inner { background: linear-gradient(150deg, #e5f5ee, #daf0e8); }
.tone-3 .block-inner { background: linear-gradient(150deg, #fff5df, #f9eed1); }
.tone-4 .block-inner { background: linear-gradient(150deg, #fceaf0, #f5e0e8); }
.tone-5 .block-inner { background: linear-gradient(150deg, #e9f1f5, #e0eaf0); }
.grid-block.is-outside .block-inner { background: #f1f3f6; border-color: #e5e9ef; }
.grid-block.is-outside .block-name, .grid-block.is-outside .block-room { color: #9ba7b3; }
.grid-block.is-current .block-inner { border: 2rpx solid #4c7cb9; box-shadow: inset 0 0 0 2rpx #fff, 0 4rpx 16rpx rgba(7, 92, 168, .16); }
.grid-block.is-pressed { opacity: .75; }
.grid-no-courses { position: absolute; top: 180rpx; width: 100%; text-align: center; font-size: 28rpx; color: #728ba0; }
.grid-no-courses > view { font-size: 22rpx; margin-top: 10rpx; }
.page-footer { padding: 22rpx 20rpx 0; color: #84919e; font-size: 21rpx; text-align: center; }
