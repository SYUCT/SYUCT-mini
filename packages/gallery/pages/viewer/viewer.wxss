page {
  height: 100%;
  overflow: hidden;
  background: #0f1720;
}

.gallery-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  color: #ffffff;
}

.gallery-head {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 20rpx 26rpx 18rpx;
  background: rgba(15, 23, 32, 0.96);
}

.gallery-title {
  font-size: 30rpx;
  font-weight: 700;
}

.gallery-counter {
  flex-shrink: 0;
  color: rgba(255, 255, 255, 0.72);
  font-size: 24rpx;
}

.gallery-swiper {
  flex: 1;
  min-height: 0;
  width: 100%;
}

.gallery-stage {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.gallery-full {
  width: 100%;
  height: 100%;
}

.gallery-foot {
  flex-shrink: 0;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  text-align: center;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.66);
  background: rgba(15, 23, 32, 0.96);
}
