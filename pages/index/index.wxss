/* pages/index/index.wxss */
.page {
  padding-bottom: 40rpx;
}

/* Hero */
.hero {
  position: relative;
  overflow: hidden;
  color: #fff;
  padding: 0;
  border-radius: 0 0 32rpx 32rpx;
}

.hero-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
}

.hero-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(100deg, rgba(3,45,77,.94) 0%, rgba(5,75,127,.80) 48%, rgba(7,92,168,.26) 100%);
  z-index: 2;
}

.hero-content {
  position: relative;
  z-index: 3;
  padding: 48rpx 40rpx 56rpx;
}

.hero-kicker {
  font-size: 24rpx;
  opacity: 0.85;
  letter-spacing: 2rpx;
  margin-bottom: 20rpx;
}

.hero-title {
  font-size: 56rpx;
  font-weight: 800;
  line-height: 1.3;
}

.hero-title-accent {
  display: block;
  background: linear-gradient(135deg, #ffd479, #ffb84d);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.hero-desc {
  font-size: 28rpx;
  opacity: 0.9;
  margin-top: 20rpx;
  line-height: 1.7;
}

.hero-desc-sub {
  display: block;
  font-size: 24rpx;
  opacity: 0.75;
  margin-top: 8rpx;
}

.hero-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}

.hero-btn {
  flex: 1;
}

.hero-btn.btn-primary {
  background: #fff;
  color: var(--primary);
}

.hero-btn.btn-secondary {
  background: rgba(255, 255, 255, 0.18);
  color: #fff;
}

.hero-meta {
  margin-top: 28rpx;
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.hero-meta .badge {
  background: rgba(255, 255, 255, 0.16);
  color: #fff;
}

/* 统计条 */
.stats-grid {
  display: flex;
  flex-wrap: wrap;
  margin: -36rpx 24rpx 0;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(7, 92, 168, 0.12);
  padding: 8rpx 0;
  position: relative;
  z-index: 2;
}

.stat-item {
  width: 33.33%;
  padding: 20rpx 12rpx;
  text-align: center;
  box-sizing: border-box;
}

.stat-value {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--primary);
}

.stat-label {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
}

/* Section */
.section {
  margin: 40rpx 24rpx 0;
}

.section-head {
  margin-bottom: 24rpx;
}

.eyebrow {
  font-size: 24rpx;
  color: var(--primary);
  font-weight: 600;
  letter-spacing: 1rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: 700;
  margin-top: 8rpx;
}

.section-lead {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-top: 8rpx;
}

/* 入口卡片 */
.portal-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.portal-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(7, 92, 168, 0.06);
  border: 1rpx solid var(--border);
  transition: transform 0.15s ease;
}

.portal-card:active {
  transform: scale(0.97);
}

.portal-icon {
  font-size: 52rpx;
  margin-bottom: 12rpx;
}

.portal-title {
  font-size: 30rpx;
  font-weight: 700;
}

.portal-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 8rpx;
  line-height: 1.5;
}

.portal-link {
  font-size: 24rpx;
  color: var(--primary);
  margin-top: 16rpx;
  font-weight: 600;
}

/* 快速问答 */
.quick-list {
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(7, 92, 168, 0.06);
  border: 1rpx solid var(--border);
  overflow: hidden;
}

.quick-item {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid var(--border);
}

.quick-item:last-child {
  border-bottom: none;
}

.quick-item:active {
  background: rgba(7, 92, 168, 0.04);
}

.quick-num {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--accent);
  margin-right: 20rpx;
  width: 48rpx;
  text-align: center;
}

.quick-body {
  flex: 1;
  min-width: 0;
}

.quick-title {
  font-size: 28rpx;
  font-weight: 600;
}

.quick-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
}

.quick-arrow {
  color: var(--text-secondary);
  font-size: 40rpx;
  margin-left: 12rpx;
}

/* 社区条 */
.community-strip {
  margin: 48rpx 24rpx 0;
  background: linear-gradient(135deg, #0b3d6e, #075ca8);
  border-radius: 24rpx;
  padding: 36rpx;
  color: #fff;
}

.community-strip .eyebrow {
  color: #ffd479;
}

.community-title {
  font-size: 34rpx;
  font-weight: 700;
  margin-top: 8rpx;
}

.community-desc {
  font-size: 26rpx;
  opacity: 0.9;
  margin-top: 12rpx;
  line-height: 1.6;
}

.community-btn {
  margin-top: 24rpx;
  background: rgba(255, 255, 255, 0.18);
  color: #fff;
}

/* 页脚 */
.site-footer {
  text-align: center;
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 48rpx;
  padding: 0 40rpx;
}

.footer-links {
  color: var(--primary);
  margin-top: 8rpx;
}

.footer-update {
  margin-top: 12rpx;
  color: var(--accent);
  font-weight: 600;
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.modal-body {
  width: 560rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx;
  text-align: center;
  max-height: 84vh;
  overflow-y: auto;
  box-sizing: border-box;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 700;
}

.modal-qq {
  font-size: 30rpx;
  color: var(--primary);
  font-weight: 700;
  margin-top: 16rpx;
}

.modal-qr {
  width: 320rpx;
  height: 320rpx;
  margin-top: 24rpx;
  border-radius: 12rpx;
  background: #f0f2f5;
}

.modal-close {
  margin-top: 28rpx;
}

/* 首页校园实景预览，与网页版首页保持一致 */
.gallery-section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
}

.gallery-more {
  color: var(--primary);
  font-size: 24rpx;
  font-weight: 600;
  flex-shrink: 0;
  padding-bottom: 6rpx;
}

.home-gallery-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
}

.home-gallery-item {
  position: relative;
  height: 190rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #e8ecf1;
}

.home-gallery-feature {
  grid-column: span 2;
  height: 300rpx;
}

.home-gallery-item image {
  width: 100%;
  height: 100%;
}

.home-gallery-label {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 34rpx 14rpx 10rpx;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.62));
  color: #fff;
  font-size: 23rpx;
}


/* 交流群列表 */
.group-option {
  margin-top: 22rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid rgba(139, 148, 158, 0.22);
}

.group-option-first {
  margin-top: 12rpx;
  padding-top: 0;
  border-top: 0;
}

.group-option-head {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  text-align: left;
}

.group-option-icon {
  width: 54rpx;
  height: 54rpx;
  border-radius: 16rpx;
  background: rgba(7, 92, 168, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  flex-shrink: 0;
}

.group-option-main {
  min-width: 0;
  flex: 1;
}

.group-option-title {
  font-size: 27rpx;
  font-weight: 700;
  color: var(--text);
}

.group-option-desc {
  margin-top: 5rpx;
  font-size: 22rpx;
  line-height: 1.55;
  color: var(--text-secondary);
}

.group-number {
  margin-top: 14rpx;
  color: var(--text-secondary);
  font-size: 23rpx;
  font-weight: 600;
}

.group-modal-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 12rpx;
}

.group-modal-btn {
  flex: 1;
  min-width: 0;
  margin-top: 0;
  padding: 13rpx 10rpx;
  border-radius: 999rpx;
  background: rgba(7, 92, 168, 0.08);
  font-size: 23rpx;
  line-height: 1.35;
  text-align: center;
}
