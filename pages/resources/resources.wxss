/* pages/resources/resources.wxss */
.page-head {
  padding: 40rpx 32rpx 8rpx;
}

.page-title {
  font-size: 40rpx;
  font-weight: 800;
}

.page-sub {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-top: 8rpx;
}

.search-wrap {
  margin: 24rpx;
}

.search-bar {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 999rpx;
  border: 1rpx solid var(--border);
  box-shadow: 0 2rpx 8rpx rgba(7, 92, 168, 0.05);
  padding: 0 24rpx;
}

.search-icon {
  color: var(--text-secondary);
  font-size: 34rpx;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  min-width: 0;
  padding: 20rpx 0;
  font-size: 28rpx;
}

.search-clear {
  width: 48rpx;
  height: 48rpx;
  line-height: 44rpx;
  border-radius: 50%;
  text-align: center;
  background: var(--bg);
  color: var(--text-secondary);
  font-size: 34rpx;
  margin-left: 12rpx;
}

.search-summary {
  color: var(--text-secondary);
  font-size: 24rpx;
  margin: 12rpx 16rpx 0;
}

.cat-card {
  background: #fff;
  border-radius: 20rpx;
  margin: 24rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(7, 92, 168, 0.06);
  border: 1rpx solid var(--border);
}

.cat-head {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.cat-name {
  font-size: 30rpx;
  font-weight: 700;
  flex: 1;
}

.cat-count {
  font-size: 22rpx;
  color: var(--text-secondary);
  background: var(--bg);
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
}

.site-link {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.contribute-tip {
  text-align: center;
  font-size: 24rpx;
  color: var(--text-secondary);
  padding: 16rpx 0 60rpx;
}
