/* pages/digital/digital.wxss */
.page-head {
  padding: 40rpx 32rpx 8rpx;
}

.page-title {
  font-size: 40rpx;
  font-weight: 800;
}

.page-sub {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-top: 8rpx;
}

.service-list {
  margin-top: 8rpx;
}

.tip-card {
  background: rgba(210, 153, 29, 0.06);
  border: 1rpx solid rgba(210, 153, 29, 0.25);
}

.tip-text {
  font-size: 26rpx;
  color: var(--text);
  line-height: 1.7;
  margin-top: 12rpx;
}

.tip-text:first-of-type {
  margin-top: 0;
}

.section-block .section-card {
  margin-top: 12rpx;
}

.doc-list-card {
  margin-top: 16rpx;
}
