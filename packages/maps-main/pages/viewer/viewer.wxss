page {
  height: 100%;
  overflow: hidden;
  background: #eef1f4;
}

.viewer-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.viewer-head {
  flex-shrink: 0;
  padding: 18rpx 24rpx 16rpx;
  background: #ffffff;
  border-bottom: 1rpx solid rgba(139, 148, 158, 0.24);
}

.viewer-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #1f2328;
}

.viewer-meta,
.viewer-tip {
  margin-top: 5rpx;
  font-size: 22rpx;
  line-height: 1.45;
  color: #57606a;
}

.viewer-tip {
  color: #075ca8;
}

.map-area {
  position: relative;
  width: 100%;
  flex: 1;
  min-height: 0;
  background: #dfe3e8;
  overflow: hidden;
}

.map-movable {
  width: 100%;
  height: 100%;
}

.map-full {
  width: 100%;
  height: 100%;
  display: block;
}

.loading-layer,
.error-layer {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 3;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  background: rgba(238, 241, 244, 0.94);
  color: #57606a;
  font-size: 25rpx;
  text-align: center;
  padding: 40rpx;
  box-sizing: border-box;
}

.loading-dot {
  width: 34rpx;
  height: 34rpx;
  border: 5rpx solid rgba(7, 92, 168, 0.2);
  border-top-color: #075ca8;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.error-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #cf222e;
}

.error-desc {
  line-height: 1.7;
}

.viewer-toolbar {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 16rpx 22rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-top: 1rpx solid rgba(139, 148, 158, 0.24);
}

.tool-button,
.reset-button {
  margin: 0;
  height: 68rpx;
  min-width: 68rpx;
  padding: 0 22rpx;
  border-radius: 18rpx;
  background: #eef6ff;
  color: #075ca8;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 68rpx;
}

.tool-button::after,
.reset-button::after {
  border: 0;
}

.reset-button {
  font-size: 24rpx;
  min-width: 152rpx;
}

.scale-value {
  min-width: 96rpx;
  text-align: center;
  font-size: 24rpx;
  font-weight: 700;
  color: #1f2328;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}
